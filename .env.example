# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1

# ── Database (Render auto-provisions this) ────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/aiesec_tool

# ── Email (SendGrid recommended for Render) ───────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-key
# DEFAULT_FROM_EMAIL=noreply@aiesec-carthage.org

# ── Celery ────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://user:pass@host:6379/0
# For Render: use the Redis URL from your Render Redis instance
# Or use Render's built-in Redis: redis://red-xxxxx:6379/0

# ── Admin ─────────────────────────────────────────────────
ADMIN_SHARED_PASSWORD=aiesec-carthage-admin

