# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
USE_CELERY=False
CRON_SECRET=un-secret-tres-long-aleatoire-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,http://localhost:8000

# ── Database (Supabase PostgreSQL) ────────────────────────
# Format: postgresql://postgres.REF:PASSWORD@db.REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.ref.supabase.co:5432/postgres

# ── Media (Cloudinary) ────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Email (Brevo SMTP — free 300 emails/day) ───────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=noreply@aiesec-carthage.org

# ── Celery (optional local only — leave USE_CELERY=False on Render)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Admin ─────────────────────────────────────────────────
ADMIN_SHARED_PASSWORD=change-me

# ── Optional: Sentry DSN ──────────────────────────────────
# SENTRY_DSN=
