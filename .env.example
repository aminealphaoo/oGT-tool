# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1

# ── Database (Supabase PostgreSQL) ────────────────────────
# Format: postgresql://postgres.REF:PASSWORD@db.REF.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres.xxx:xxx@db.xxx.supabase.co:5432/postgres

# ── EXPA ───────────────────────────────────────────────────
# Token from https://auth.aiesec.org/developers/applications
# Also stored in SiteConfig model (editable via admin panel)

# ── Email (Brevo SMTP — free 300 emails/day) ───────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=b4692c001@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=noreply@aiesec-carthage.org

# ── Celery ────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://user:pass@host:6379/0

# ── Admin ─────────────────────────────────────────────────
ADMIN_SHARED_PASSWORD=aiesec-carthage-admin

# ── Optional: Sentry DSN ──────────────────────────────────
# SENTRY_DSN=
